# Copy this file to `.env` and fill in only what you use. `.env` is git-ignored.
# Phase 1 needs none of these: every Phase 1 data source is free and keyless.

# Phase 3 (optional): Telegram read-only access, created at my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Phase 2 (optional): free Solana RPC key, e.g. Helius
HELIUS_API_KEY=

# Disabled: X/Twitter is paid per post read. Do not fill in without deciding to enable it.
X_BEARER_TOKEN=
